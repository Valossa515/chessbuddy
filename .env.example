# Chave da API do Claude (ou use `ant auth login`)
ANTHROPIC_API_KEY=
# Modelo usado pelo treinador
CHESSBUDDY_MODEL=claude-opus-5
# Profundidade de análise do Stockfish (maior = mais lento e mais preciso)
CHESSBUDDY_DEPTH=14
# Opcional: caminho para um Stockfish nativo (mais rápido que o WASM)
STOCKFISH_PATH=
PORT=3000
